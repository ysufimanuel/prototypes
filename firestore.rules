rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToChurch(churchId) {
      return userExists() && getUserProfile().churchId == churchId;
    }

    function isAdmin(churchId) {
      return belongsToChurch(churchId)
        && getUserProfile().role in ['admin', 'superadmin'];
    }

    function isSuperAdmin(churchId) {
      return belongsToChurch(churchId)
        && getUserProfile().role == 'superadmin';
    }

    function isChatUser() {
      return userExists() && getUserProfile().churchId != null;
    }

    match /users/{uid} {
      allow read: if isAuthenticated()
        && (
          request.auth.uid == uid
          || (
            userExists()
            && resource.data.churchId == getUserProfile().churchId
          )
        );

      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (
          (
            request.resource.data.role == 'superadmin'
            && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId))
            && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)).data.superadminUid == uid
          )
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == request.resource.data.churchId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
            && request.resource.data.role == 'user'
          )
        );

      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'role', 'churchId', 'status', 'createdAt'
        ]);

      allow update: if isAuthenticated()
        && userExists()
        && getUserProfile().role == 'superadmin'
        && request.auth.uid != uid
        && resource.data.churchId == getUserProfile().churchId
        && request.resource.data.churchId == resource.data.churchId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isAuthenticated()
        && userExists()
        && getUserProfile().role == 'superadmin'
        && request.auth.uid != uid
        && resource.data.churchId == getUserProfile().churchId;
    }

    match /messages/{messageId} {
      allow read: if isChatUser()
        && resource.data.churchId == getUserProfile().churchId
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if isChatUser()
        && request.resource.data.keys().hasOnly([
          'senderId', 'receiverId', 'churchId', 'content', 'timestamp', 'read'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.churchId == getUserProfile().churchId
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.senderId is string
        && request.resource.data.receiverId is string
        && request.resource.data.churchId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.timestamp is string
        && request.resource.data.read == false
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.churchId == getUserProfile().churchId;

      allow update, delete: if false;
    }

    match /churches/{churchId} {
      allow read: if belongsToChurch(churchId);
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSuperAdmin(churchId);
      allow delete: if false;

      match /members/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /families/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /groups/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /events/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /attendance/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /donations/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /donors/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /volunteers/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /assignments/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /announcements/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /notifications/{docId} {
        allow read: if belongsToChurch(churchId)
          && (
            resource.data.get('userId', null) == null
            || resource.data.get('userId', null) == request.auth.uid
          );

        allow create: if belongsToChurch(churchId)
          && (
            request.resource.data.get('userId', null) == request.auth.uid
            || (
              request.resource.data.get('userId', null) == null
              && isAdmin(churchId)
            )
          );

        allow update: if belongsToChurch(churchId)
          && resource.data.get('userId', null) == request.auth.uid
          && request.resource.data.get('userId', null) == resource.data.get('userId', null);

        allow delete: if isSuperAdmin(churchId)
          || (
            belongsToChurch(churchId)
            && resource.data.get('userId', null) == request.auth.uid
          );
      }

      match /pemasukan/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /pengeluaran/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /financeCategories/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /financeConfig/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /approvalHistory/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update, delete: if isSuperAdmin(churchId);
      }

      // Website Manager: config, navigation, and website metadata.
      match /website/{docId} {
        allow read, create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);

        // Actual backend path: churches/{churchId}/website/content/pages/{pageId}
        match /content/{contentId}/pages/{pageId} {
          allow read, create, update: if isAdmin(churchId);
          allow delete: if isSuperAdmin(churchId);
        }
      }
    }

    // Published public website data is intentionally read-only from clients.
    match /publicSites/{churchId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Public slug lookup is read-only from clients.
    match /siteSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
