rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToChurch(churchId) {
      return userExists() && getUserProfile().churchId == churchId;
    }

    function isAdmin(churchId) {
      return belongsToChurch(churchId) &&
        (getUserProfile().role == 'admin' || getUserProfile().role == 'superadmin');
    }

    function isSuperAdmin(churchId) {
      return belongsToChurch(churchId) && getUserProfile().role == 'superadmin';
    }

    function isChatUser(churchId) {
      return belongsToChurch(churchId) &&
        (getUserProfile().role == 'user' ||
         getUserProfile().role == 'admin' ||
         getUserProfile().role == 'superadmin');
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isSuperAdmin(resource.data.churchId);
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid ||
         (resource.data.churchId != null && belongsToChurch(resource.data.churchId)));
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.churchId is string &&
        belongsToChurch(request.resource.data.churchId);
      allow update, delete: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         (resource.data.churchId != null && isAdmin(resource.data.churchId)));
    }

    match /churches/{churchId} {
      allow read: if belongsToChurch(churchId);
      allow create: if isSuperAdmin(churchId);
      allow update: if isAdmin(churchId);
      allow delete: if isSuperAdmin(churchId);

      match /members/{memberId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /families/{familyId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /groups/{groupId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /events/{eventId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /attendance/{attendanceId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /donations/{donationId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /donors/{donorId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /volunteers/{volunteerId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /assignments/{assignmentId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /announcements/{announcementId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /notifications/{notificationId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /pemasukan/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /pengeluaran/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /financeCategories/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /financeConfig/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }

      match /approvalHistory/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update, delete: if isSuperAdmin(churchId);
      }

      // Website Manager: config, navigation, and website metadata.
      match /website/{docId} {
        allow read, create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);

        // Actual backend path: churches/{churchId}/website/content/pages/{pageId}
        match /pages/{pageId} {
          allow read, create, update: if isAdmin(churchId);
          allow delete: if isSuperAdmin(churchId);
        }
      }
    }

    // Published public website data is intentionally read-only from clients.
    match /publicSites/{churchId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Public slug lookup is read-only from clients.
    match /siteSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
