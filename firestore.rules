rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToChurch(churchId) {
      return userExists() && getUserProfile().churchId == churchId;
    }

    function isAdmin(churchId) {
      return belongsToChurch(churchId)
        && getUserProfile().role in ['admin', 'superadmin'];
    }

    function isSuperAdmin(churchId) {
      return belongsToChurch(churchId)
        && getUserProfile().role == 'superadmin';
    }

    function isChatUser() {
      return userExists() && getUserProfile().churchId != null;
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (
        request.auth.uid == uid
        || (userExists() && resource.data.churchId == getUserProfile().churchId)
      );

      // Initial registration creates only the authenticated user's own
      // superadmin profile. Admin-created users are provisioned by the
      // Admin SDK endpoint, never by an untrusted client write.
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'superadmin'
        && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId))
        && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)).data.superadminUid == uid;

      // Users may edit ordinary profile fields only; role, tenant, identity,
      // status and audit fields remain protected.
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'role', 'churchId', 'status', 'createdAt', 'createdBy',
          'updatedBy'
        ]);

      // Superadmin role changes are performed through the Admin SDK endpoint.
      // This rule also blocks direct client attempts to change role/churchId.
      allow update: if false;

      allow delete: if isSuperAdmin(resource.data.churchId)
        && request.auth.uid != uid;
    }

    match /messages/{messageId} {
      allow read: if isChatUser()
        && resource.data.churchId == getUserProfile().churchId
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isChatUser()
        && request.resource.data.keys().hasOnly(['senderId', 'receiverId', 'churchId', 'content', 'timestamp', 'read'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.churchId == getUserProfile().churchId
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.timestamp is string
        && request.resource.data.read == false
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.churchId == getUserProfile().churchId;

      allow update, delete: if false;
    }

    match /churches/{churchId} {
      allow read: if belongsToChurch(churchId);
      allow create: if isAuthenticated() && !userExists();
      allow update: if isSuperAdmin(churchId);
      allow delete: if false;

      match /members/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /families/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /groups/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /events/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /attendance/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /donations/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /donors/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /volunteers/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /assignments/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /announcements/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /notifications/{docId} {
        allow read, create, update: if belongsToChurch(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /pemasukan/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /pengeluaran/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /financeCategories/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /financeConfig/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
      match /approvalHistory/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update, delete: if isSuperAdmin(churchId);
      }
      match /deaths/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if isAdmin(churchId);
        allow delete: if isSuperAdmin(churchId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
